{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
  },
  "exclude": [
    "lib",
    "node_modules",
    "src/test/**.ts"
  ],
  "include": [
    "src/**.ts",
  ],
}